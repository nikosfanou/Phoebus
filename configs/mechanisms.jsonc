    "headers": {
        "Access-Control-Allow-Credentials": {
            "directives" : ["true"],
            "multiple_directives" : false,
            "multiple_values" : false
        },
        "Access-Control-Allow-Headers": { // Set all request headers here
            "directives_delimiter" : ",",
            "directives" : ["*", "{HEADER_NAME}"],
            "placeholders" : {
                "{HEADER_NAME}" : ["{CLIENT_HINTS}", "Content-Type", "Content-Length", "Content-Encoding", "Authorization", "Cookie", "Proxy-Authorization", "From", "Host", "User-Agent", "Accept", "Accept-Language", "Accept-Encoding", "Referer", "Expect", "Max-Forwards", "Connection", "Keep-Alive", "Upgrade-Insecure-Requests", "If-Match", "If-Modified-Since", "If-Unmodified-Since", "If-None-Match", "Cache-Control", "Access-Control-Request-Headers", "Access-Control-Request-Method", "Origin", "Content-Disposition", "Content-Digest", "Prefer", "Forwarded", "Via", "Range", "If-Range", "Sec-Fetch-Site", "Sec-Fetch-Mode", "Sec-Fetch-User", "Sec-Fetch-Dest", "Sec-Purpose", "Service-Worker-Navigation-Preload", "Sec-Fetch-Storage-Access", "Sec-WebSocket-Extensions", "Sec-WebSocket-Protocol", "Sec-WebSocket-Key", "Transfer-Encoding", "TE", "Trailer", "Alt-Used", "Link", "Date", "Service-Worker", "Upgrade", "Priority", "Attribution-Reporting-Eligible", "DNT", "Sec-GPC", "Sec-Browsing-Topics", "Early-Data", "Idempotency-Key", "Sec-Speculation-Tags", "Pragma", "Warning"],
                "{CLIENT_HINTS}": ["Sec-CH-UA", "Sec-CH-UA-Arch", "Sec-CH-UA-Bitness", "Sec-CH-UA-Form-Factors", "Sec-CH-UA-Full-Version", "Sec-CH-UA-Full-Version-List", "Sec-CH-UA-Mobile", "Sec-CH-UA-Model", "Sec-CH-UA-Platform", "Sec-CH-UA-Platform-Version", "Sec-CH-UA-WoW64", "Sec-CH-Prefers-Color-Scheme", "Sec-CH-Prefers-Reduced-Motion", "Sec-CH-Prefers-Reduced-Transparency", "Sec-CH-Device-Memory", "Sec-CH-DPR", "Sec-CH-Viewport-Height", "Sec-CH-Viewport-Width", "Sec-CH-Width", "Device-Memory", "DPR", "Viewport-Width", "Width", "Downlink", "ECT", "RTT", "Save-Data"]
            },
            "multiple_directives" : true,
            "multiple_values" : false
        },
        "Access-Control-Allow-Methods": {
            "directives_delimiter" : ",",
            "directives" : ["*", "{METHODS}"],
            "placeholders": {
                "{METHODS}": ["PUT", "DELETE", "CONNECT", "OPTIONS", "GET", "HEAD", "POST"]
            },
            "multiple_directives" : true,
            "multiple_values" : false
        },
        "Access-Control-Allow-Origin": {
            "directives" : ["*", "null", "{ORIGIN}"],
            "placeholders": {
                "{ORIGIN}": ["{EXAMPLE}", "{CROSSEXAMPLE}", "{SUB_EXAMPLE}"]
            },
            "multiple_directives" : false,
            "multiple_values" : false
        },
        "Access-Control-Expose-Headers": { // Set all response headers here
            "directives_delimiter" : ",",
            "directives" : ["*", "{HEADER_NAME}"],
            "placeholders" : {
                "{HEADER_NAME}" : ["WWW-Authenticate", "Proxy-Authenticate", "Set-Cookie", "Age", "Cache-Control", "Clear-Site-Data", "Expires", "No-Vary-Search", "Last-Modified", "ETag", "Vary", "Connection", "Keep-Alive", "Accept", "Accept-Encoding", "Accept-Patch", "Accept-Post", "Access-Control-Allow-Credentials", "Access-Control-Allow-Headers", "Access-Control-Allow-Methods", "Access-Control-Allow-Origin", "Access-Control-Expose-Headers", "Access-Control-Max-Age", "Timing-Allow-Origin", "Content-Disposition", "Integrity-Policy", "Integrity-Policy-Report-Only", "Content-Length", "Preference-Applied", "Via", "Accept-Ranges", "Content-Range", "Location", "Refresh", "Referrer-Policy", "Allow", "Server", "Cross-Origin-Embedder-Policy", "Cross-Origin-Opener-Policy", "Cross-Origin-Resource-Policy", "Content-Security-Policy", "Content-Security-Policy-Report-Only", "Permissions-Policy", "Expect-CT", "Reporting-Endpoints", "Report-To", "Strict-Transport-Security", "X-Content-Type-Options", "X-Frame-Options", "X-Permitted-Cross-Domain-Policies", "X-Powered-By", "X-XSS-Protection", "Activate-Storage-Access", "Transfer-Encoding", "Trailer", "Sec-WebSocket-Accept", "Sec-WebSocket-Extensions", "Sec-WebSocket-Protocol", "Sec-WebSocket-Version", "Alt-Svc", "Date", "Link", "Retry-After", "Server-Timing", "Service-Worker-Allowed", "SourceMap", "Upgrade", "Priority", "Attribution-Reporting-Register-Source", "Attribution-Reporting-Register-Trigger", "Accept-CH", "Critical-CH", "Tk", "Origin-Agent-Cluster", "NEL", "Observe-Browsing-Topics", "Set-Login", "Speculation-Rules", "Supports-Loading-Mode", "X-DNS-Prefetch-Control", "X-Robots-Tag", "Pragma", "Warning"]
            },
            "multiple_directives" : true,
            "multiple_values" : false
        },
        "Access-Control-Max-Age": {
            "directives" : ["{EXPIRES}"],
            "placeholders": {
                "{EXPIRES}": ["0", "600"]
            },
            "multiple_directives" : false,
            "multiple_values" : false
        },
        "Activate-Storage-Access": {
            "directives" : {
                "retry" : ["", ";allowed-origin={ORIGIN}"],
                "load" : []
            },
            "placeholders" : {
