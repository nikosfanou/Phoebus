                "style-src" : ["'none'", "'unsafe-inline'", "{SOURCE_EXPRESSION_LIST}", "'unsafe-hashes'", "'{STYLE_HASH}'", "'nonce-abcxyz'", "{OPAQUE_SCHEME_SOURCE}", "'report-sample'"],
                "style-src-attr" : ["'none'", "'unsafe-inline'", "'unsafe-hashes'", "'{STYLE_HASH}'", "'report-sample'"],
                "style-src-elem" : ["'none'", "'unsafe-inline'", "{SOURCE_EXPRESSION_LIST}", "'{STYLE_HASH}'", "'nonce-abcxyz'", "{OPAQUE_SCHEME_SOURCE}", "'report-sample'"],
                "trusted-types": ["'none'", "'allow-duplicates'", "{POLICY_NAME}"],
                "upgrade-insecure-requests": [],
