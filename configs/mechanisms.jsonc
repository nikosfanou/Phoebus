                "{HOST_SOURCE}" : ["{ALL_HOSTS}", "{ALL_HOSTS}{PATH}", "{ALL_HOSTS}:{PORTS}", "{SCHEME_SOURCE}//{ALL_HOSTS}", "{SCHEME_SOURCE}//{ALL_HOSTS}{PATH}", "{SCHEME_SOURCE}//{ALL_HOSTS}:{PORTS}", "{ALL_HOSTS}:{PORTS}{PATH}", "{SCHEME_SOURCE}//{ALL_HOSTS}:{PORTS}{PATH}"],
                "{ALL_HOSTS}": ["{HOST}", "{SUBDOMAIN}.{HOST}"],
